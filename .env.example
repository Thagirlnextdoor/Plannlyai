# Copy to .env and fill in. NEVER commit .env.
# Local Postgres (native install, free). NOTE: encode @ in password as %40.
DATABASE_URL=postgresql://postgres:Stacy%40598@localhost:5432/plannlyai

# Better Auth (free, self-hosted)
BETTER_AUTH_SECRET=replace-with-32-byte-hex
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional for v1, free)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP for magic-link / notifications (free default: Gmail SMTP or Ethereal dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Storage backend: local ($0 default) | r2 (Cloudflare free tier, optional)
STORAGE_BACKEND=local

# R2 — only needed if STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# AI — free-only. offline ($0) | ollama (local, $0) | gemini | groq | hf | openrouter
AI_PROVIDER=offline
OLLAMA_MODEL=llama3.1:8b

# Cron worker shared secret (self-hosted reminders)
CRON_SECRET=replace-with-random-string
